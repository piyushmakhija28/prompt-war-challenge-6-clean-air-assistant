%% Data Flow Diagram: Direct Impact Mathematical Calculus
flowchart TD
    classDef input fill:#0D47A1,stroke:#1976D2,stroke-width:2px,color:#FFF;
    classDef process fill:#1B5E20,stroke:#388E3C,stroke-width:2px,color:#FFF;
    classDef output fill:#B71C1C,stroke:#D32F2F,stroke-width:2px,color:#FFF;

    AQI["Outdoor AQI Input<br/>[e.g. 395]"]:::input
    HOURS["Shifted Hours (Δt)<br/>[e.g. 2.0 hours]"]:::input
    VULN["Vulnerability Profile<br/>[Infant, Asthma]"]:::input
    COMMUTE["Commute Distance & Mode<br/>[15 km, Two-Wheeler]"]:::input

    CONC["Outdoor Concentration C_out<br/>[C_out ≈ 243 µg/m³]"]:::process
    VENT["Minute Ventilation V_E<br/>[Child: 0.30 m³/h, Adult: 0.45 m³/h]"]:::process
    DEPO["Alveolar Deposition Fraction<br/>[η_dep ≈ 0.28 for PM2.5]"]:::process
    INDOOR["Indoor Filtered Baseline C_in<br/>[C_in ≈ 45 µg/m³ via Corsi-Rosenthal]"]:::process

    DOSE_MATH["Inhaled Dose Calculus<br/>ΔD = (C_out - C_in) × V_E × Δt × η_dep"]:::process
    CIG_MATH["Cigarette Equivalence<br/>Cigs = ΔD / 66.5 µg"]:::process
    CO2_MATH["Carbon Accounting<br/>ΔCO2 = d × (EF_base - EF_alt)"]:::process

    UG_OUT["Micrograms PM2.5 Inhalation Avoided<br/>[e.g. 33.3 µg]"]:::output
    CIG_OUT["Cigarettes Avoided Equivalent<br/>[e.g. 0.50 cigarettes]"]:::output
    CO2_OUT["CO2e Greenhouse Gas Avoided<br/>[e.g. 0.48 kg CO2e]"]:::output
    SCORE_OUT["Community Protection Index<br/>[89% Lung Shield Score]"]:::output

    AQI --> CONC
    VULN --> VENT
    CONC & INDOOR & VENT & HOURS & DEPO --> DOSE_MATH
    DOSE_MATH --> CIG_MATH
    DOSE_MATH --> UG_OUT
    CIG_MATH --> CIG_OUT
    COMMUTE --> CO2_MATH
    CO2_MATH --> CO2_OUT
    DOSE_MATH & CO2_MATH --> SCORE_OUT
